      "speaker": "katya",
      "mode": "core",
      "text": "Вот сюда!",
      "audio": "assets/audio/voice/camp_hang_01.mp3"
    },
    {
      "id": "camp_hang_02",
      "scene": "camp",
      "block": "hang",
      "speaker": "alsu",
      "mode": "core",
      "text": "Держится. Можно звонить.",
      "audio": "assets/audio/voice/camp_hang_02.mp3"
    },
    {
      "id": "camp_no_ladle_01",
      "scene": "camp",
      "block": "no_ladle",
      "speaker": "narrator",
      "mode": "reaction",
      "text": "Без языка колокол изображает абажур. Очень убедительно.",
      "audio": "assets/audio/voice/camp_no_ladle_01.mp3"
    },
    {
      "id": "camp_ring_01",
      "scene": "camp",
      "block": "ring",
      "speaker": "sanka",
      "mode": "core",
      "text": "Я тоже!",
      "audio": "assets/audio/voice/camp_ring_01.mp3"
    },
    {
      "id": "camp_ring_02",
      "scene": "camp",
      "block": "ring",
      "speaker": "nata",
      "mode": "core",
      "text": "В следующий раз. Сейчас ровно три удара, это сигнал.",
      "audio": "assets/audio/voice/camp_ring_02.mp3"
    },
    {
      "id": "camp_rescue_01",
      "scene": "camp",
      "block": "rescue",
      "speaker": "ranger",
      "mode": "core",
      "text": "Спасибо. Чуть весло не сломал.",
      "audio": "assets/audio/voice/camp_rescue_01.mp3"
    },
    {
      "id": "camp_rescue_02",
      "scene": "camp",
      "block": "rescue",
      "speaker": "nata",
      "mode": "core",
      "text": "А почему сразу верёвку не бросили?",
      "audio": "assets/audio/voice/camp_rescue_02.mp3"
    },
    {
      "id": "camp_rescue_03",
      "scene": "camp",
      "block": "rescue",
      "speaker": "ranger",
      "mode": "core",
      "text": "Надеялся выбраться сам.",
      "audio": "assets/audio/voice/camp_rescue_03.mp3"
    },
    {
      "id": "camp_rescue_04",
      "scene": "camp",
      "block": "rescue",
      "speaker": "anton",
      "mode": "core",
      "text": "Мы заметили. Камыши тоже.",
      "audio": "assets/audio/voice/camp_rescue_04.mp3"
    },
    {
      "id": "camp_key_known_01",
      "scene": "camp",
      "block": "key_known",
      "speaker": "nata",
      "mode": "core",
      "text": "У вас ключ от моста?",
      "audio": "assets/audio/voice/camp_key_known_01.mp3"
    },
    {
      "id": "camp_key_known_02",
      "scene": "camp",
      "block": "key_known",
      "speaker": "ranger",
      "mode": "core",
      "text": "Здесь. Смотритель сердится?",
      "audio": "assets/audio/voice/camp_key_known_02.mp3"
    },
    {
      "id": "camp_key_known_03",
      "scene": "camp",
      "block": "key_known",
      "speaker": "nata",
      "mode": "core",
      "text": "Пока просто хочет домой. Лучше успеть до следующей стадии.",
      "audio": "assets/audio/voice/camp_key_known_03.mp3"
    },
    {
      "id": "camp_key_early_01",
      "scene": "camp",
      "block": "key_early",
      "speaker": "ranger",
      "mode": "alternate",
      "text": "Мне теперь к мосту. Ключ смотрителю вернуть.",
      "audio": "assets/audio/voice/camp_key_early_01.mp3"
    },
    {
      "id": "camp_rescue_end_01",
      "scene": "camp",
      "block": "rescue_end",
      "speaker": "anton",
      "mode": "core",
      "text": "На ужин вернётесь?",
      "audio": "assets/audio/voice/camp_rescue_end_01.mp3"
    },
    {
      "id": "camp_rescue_end_02",
      "scene": "camp",
      "block": "rescue_end",
      "speaker": "nata",
      "mode": "core",
      "text": "Все к Линочке. Заодно половник верну.",
      "audio": "assets/audio/voice/camp_rescue_end_02.mp3"
    },
    {
      "id": "camp_shout_again_01",
      "scene": "camp",
      "block": "shout_again",
      "speaker": "nata",
      "mode": "reaction",
      "text": "Он видит нас, но не слышит. Нужен условный сигнал.",
      "audio": "assets/audio/voice/camp_shout_again_01.mp3"
    },
    {
      "id": "camp_wood_hit_01",
      "scene": "camp",
      "block": "wood_hit",
      "speaker": "narrator",
      "mode": "reaction",
      "text": "По дереву получается слишком тихо. Для сигнала нужен колокол.",
      "audio": "assets/audio/voice/camp_wood_hit_01.mp3"
    },
    {
      "id": "camp_signal_hint_01",
      "scene": "camp",
      "block": "signal_hint",
      "speaker": "narrator",
      "mode": "hint",
      "text": "Подвесить колокол на крючок и ударить половником три раза.",
      "audio": "assets/audio/voice/camp_signal_hint_01.mp3"
    },
    {
      "id": "gate_return_01",
      "scene": "gate",
      "block": "return",
      "speaker": "ranger",
      "mode": "core",
      "text": "Ключ. Извините, задержался.",
      "audio": "assets/audio/voice/gate_return_01.mp3"
    },
    {
      "id": "gate_return_02",
      "scene": "gate",
      "block": "return",
      "speaker": "keeper",
      "mode": "core",
      "text": "Я заметил.",
      "audio": "assets/audio/voice/gate_return_02.mp3"
    },
    {
      "id": "gate_return_03",
      "scene": "gate",
      "block": "return",
      "speaker": "keeper",
      "mode": "core",
      "text": "Осталась отметка в журнале.",
      "audio": "assets/audio/voice/gate_return_03.mp3"
    },
    {
      "id": "gate_signature_01",
      "scene": "gate",
      "block": "signature",
      "speaker": "nata",
      "mode": "core",
      "text": "Можно книгу на землю?",
      "audio": "assets/audio/voice/gate_signature_01.mp3"
    },
    {
      "id": "gate_signature_02",
      "scene": "gate",
      "block": "signature",
      "speaker": "keeper",
      "mode": "core",
      "text": "Можно. Только страницу чистую откройте.",
      "audio": "assets/audio/voice/gate_signature_02.mp3"
    },
    {
      "id": "gate_lift_pryg_01",
      "scene": "gate",
      "block": "lift_pryg",
      "speaker": "narrator",
      "mode": "reaction",
      "text": "Наталья могла бы поднять Прыга. Но он уже понял, что сегодня передвигать будут мебель.",
      "audio": "assets/audio/voice/gate_lift_pryg_01.mp3"
    },
    {
      "id": "gate_signature_hint_01",
      "scene": "gate",
      "block": "signature_hint",
      "speaker": "ranger",
      "mode": "hint",
      "text": "Книгу и подушку можно положить рядом. Пусть перепрыгнет с одной на другую.",
      "audio": "assets/audio/voice/gate_signature_hint_01.mp3"
    },
    {
      "id": "gate_signed_01",
      "scene": "gate",
      "block": "signed",
      "speaker": "keeper",
      "mode": "core",
      "text": "Это подпись?",
      "audio": "assets/audio/voice/gate_signed_01.mp3"
    },
    {
      "id": "gate_signed_02",
      "scene": "gate",
      "block": "signed",
      "speaker": "nata",
      "mode": "core",
      "text": "Это всё, чем он может подписаться.",
      "audio": "assets/audio/voice/gate_signed_02.mp3"
    },
    {
      "id": "gate_signed_03",
      "scene": "gate",
      "block": "signed",
      "speaker": "keeper",
      "mode": "core",
      "text": "Зато разборчивее, чем у лесничего.",
      "audio": "assets/audio/voice/gate_signed_03.mp3"
    },
    {
      "id": "gate_signed_04",
      "scene": "gate",
      "block": "signed",
      "speaker": "ranger",
      "mode": "core",
      "text": "Я в перчатках был.",
      "audio": "assets/audio/voice/gate_signed_04.mp3"
    },
    {
      "id": "gate_farewell_01",
      "scene": "gate",
      "block": "farewell",
      "speaker": "nata",
      "mode": "core",
      "text": "Беги. То есть прыгай.",
      "audio": "assets/audio/voice/gate_farewell_01.mp3"
    },
    {
      "id": "gate_print_01",
      "scene": "gate",
      "block": "print",
      "speaker": "narrator",
      "mode": "optional",
      "text": "След занимает почти всю страницу. Зато никто ничего не допишет.",
      "audio": "assets/audio/voice/gate_print_01.mp3"
    },
    {
      "id": "finale_arrival_01",
      "scene": "finale",
      "block": "arrival",
      "speaker": "linochka",
      "mode": "core",
      "text": "Половник?",
      "audio": "assets/audio/voice/finale_arrival_01.mp3"
    },
    {
      "id": "finale_arrival_02",
      "scene": "finale",
      "block": "arrival",
      "speaker": "nata",
      "mode": "core",
      "text": "Сейчас вымою.",
      "audio": "assets/audio/voice/finale_arrival_02.mp3"
    },
    {
      "id": "finale_washed_01",
      "scene": "finale",
      "block": "washed",
      "speaker": "linochka",
      "mode": "core",
      "text": "Вот и хорошо. Садись.",
      "audio": "assets/audio/voice/finale_washed_01.mp3"
    },
    {
      "id": "finale_dinner_01",
      "scene": "finale",
      "block": "dinner",
      "speaker": "sanka",
      "mode": "core",
      "text": "Я тоже хотел в колокол!",
      "audio": "assets/audio/voice/finale_dinner_01.mp3"
    },
    {
      "id": "finale_dinner_02",
      "scene": "finale",
      "block": "dinner",
      "speaker": "katya",
      "mode": "core",
      "text": "А я нашла, куда повесить!",
      "audio": "assets/audio/voice/finale_dinner_02.mp3"
    },
    {
      "id": "finale_dinner_03",
      "scene": "finale",
      "block": "dinner",
      "speaker": "irina",
      "mode": "core",
      "text": "Все молодцы. Тарелки передавайте.",
      "audio": "assets/audio/voice/finale_dinner_03.mp3"
    },
    {
      "id": "finale_gift_01",
      "scene": "finale",
      "block": "gift",
      "speaker": "nata",
      "mode": "core",
      "text": "Ты приготовил подарок?",
      "audio": "assets/audio/voice/finale_gift_01.mp3"
    },
    {
      "id": "finale_gift_02",
      "scene": "finale",
      "block": "gift",
      "speaker": "victor",
      "mode": "core",
      "text": "После того Нового года я стараюсь.",
      "audio": "assets/audio/voice/finale_gift_02.mp3"
    },
    {
      "id": "finale_gift_03",
      "scene": "finale",
      "block": "gift",
      "speaker": "nata",
      "mode": "core",
      "text": "Когда я спросила про подарок маме с папой?",
      "audio": "assets/audio/voice/finale_gift_03.mp3"
    },
    {
      "id": "finale_gift_04",
      "scene": "finale",
      "block": "gift",
      "speaker": "victor",
      "mode": "core",
      "text": "Угу. До этого я считал, что у Деда Мороза всё под контролем.",
      "audio": "assets/audio/voice/finale_gift_04.mp3"
    },
    {
      "id": "finale_goodnight_01",
      "scene": "finale",
      "block": "goodnight",
      "speaker": "siblings",
      "mode": "core",
      "text": "Спокойной ночи мама и папа от Вити и от Наташи.",
      "audio": "assets/audio/voice/finale_goodnight_01.mp3"
    },
    {
      "id": "finale_greeting_01",
      "scene": "finale",
      "block": "greeting",
      "speaker": "victor",
      "mode": "core",
      "text": "Натка, с днём рождения! Я очень счастлив, что у нас такая замечательная семья. Спасибо за все наши приключения. Витя.",
      "audio": "assets/audio/voice/finale_greeting_01.mp3"
    }
  ]
}
